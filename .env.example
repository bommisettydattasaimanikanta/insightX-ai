# InsightForge AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & Authentication
SECRET_KEY=insightforge-super-secret-jwt-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
DATA_DIR=./data
UPLOAD_MAX_BYTES=209715200  # 200MB
DB_URL=sqlite:///./data/insightforge_meta.db

# LLM Providers (Gemini default, OpenAI / Anthropic swappable)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Execution Sandbox Limits
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_MEMORY_MB=512
MAX_QUERY_ROWS=10000
